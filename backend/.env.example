# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite — default, no setup required)
DATABASE_URL=sqlite:///./ecommerce.db

# Production (PostgreSQL — set this in Vercel env vars)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Development default — localhost origins are included automatically
# Production: set to your Vercel frontend URL
CORS_ORIGINS=https://your-frontend-app.vercel.app

# ─── Admin Account (used by create_admin.py seed script) ─────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
